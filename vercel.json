{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/rsvps/export.xlsx",
      "destination": "/api/rsvps/download-excel"
    },
    {
      "source": "/api/rsvps/export/excel",
      "destination": "/api/rsvps/download-excel"
    },
    {
      "source": "/api/rsvps/excel",
      "destination": "/api/rsvps/download-excel"
    },
    {
      "source": "/api/rsvps/export.csv",
      "destination": "/api/rsvps/download-csv"
    }
  ]
}
